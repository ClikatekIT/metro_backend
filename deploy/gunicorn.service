[Unit]
Description=Gunicorn daemon for MetroJobs Django API
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/metro-backend
EnvironmentFile=/var/www/metro-backend/.env
ExecStart=/var/www/metro-backend/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/gunicorn/metro.sock \
    --access-logfile /var/log/gunicorn/metro-access.log \
    --error-logfile /var/log/gunicorn/metro-error.log \
    metrojobs_django.wsgi:application
RuntimeDirectory=gunicorn
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
